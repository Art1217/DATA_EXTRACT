# Copia este archivo a `.env` y ajusta lo que necesites.
# Todo es opcional: sin `.env` la API arranca en modo demo (AI_PROVIDER=fake).

# --- Proveedor de IA ------------------------------------------------------
# fake          -> respuestas deterministas, sin credenciales ni costo (demo)
# vertex        -> Gemini en Vertex AI (ADC o service account)
# gemini_api    -> Gemini con API key de Google AI Studio
# claude_vertex -> Claude en Vertex AI Model Garden (mismas credenciales de GCP;
#                  el modelo debe estar habilitado en Model Garden)
# anthropic     -> Claude con la API de Anthropic
AI_PROVIDER=fake
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Proveedor solo para extracción y calidad. Ej.: buscar con Gemini Flash y
# extraer con Claude:  AI_PROVIDER=vertex  AI_PROVIDER_EXTRACT=claude_vertex
# AI_PROVIDER_EXTRACT=

# Solo Claude. Esfuerzo: low | medium | high | xhigh | max (vacío = el del modelo)
# CLAUDE_EFFORT_CLASSIFY=medium
# CLAUDE_EFFORT_EXTRACT=high
# Modelo que reintenta si el principal declina por política (también habilitado)
# CLAUDE_FALLBACK_MODEL=

# --- Google Cloud ---------------------------------------------------------
# GCP_PROJECT_ID=mi-proyecto
# GCP_LOCATION=global
# Sin CREDENTIALS_PATH se usan las Application Default Credentials:
#   gcloud auth application-default login
# CREDENTIALS_PATH=credentials/service-account.json

# Clasificación, identidad y búsqueda / extracción y calidad. Con Claude, por
# ejemplo: claude-haiku-5-5 / claude-opus-5-5 (en Vertex, el ID sin prefijo).
# MODEL_NAME_CLASSIFY=gemini-3-flash-preview
# MODEL_NAME_EXTRACT=gemini-3-pro-preview

# --- Document AI (OCR de PDFs escaneados) ---------------------------------
# DOCAI_PROCESSOR_ID=
# DOCAI_LOCATION=us

# --- Storage --------------------------------------------------------------
# local -> ./Storage ;  gcs -> todo vive en GCS_BUCKET
STORAGE_BACKEND=local
# GCS_BUCKET=mi-bucket
# GCS_PREFIX=

# --- Publicación de entregables (GCS + BigQuery) --------------------------
PUBLISH_ENABLED=false
# BIGQUERY_DATASET=document_extraction
# BIGQUERY_TABLE=extractions
# BIGQUERY_LOCATION=US

# --- Procesamiento --------------------------------------------------------
# DPI=300
# BLOCK_SIZE=30
# JOB_WORKERS=2
# MAX_CONCURRENT_LLM_CALLS=6
# QUALITY_TOLERANCE=1.0

# --- API ------------------------------------------------------------------
# API_KEY=          # si se define, todo /v1 exige la cabecera X-API-Key
# LANGSMITH_API_KEY=
# LOG_LEVEL=INFO
